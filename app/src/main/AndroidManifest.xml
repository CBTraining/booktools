<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.topbardrop"
    android:versionCode="1019"
    android:versionName="1.019">

    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:resizeableActivity="true"
        android:icon="@drawable/ic_drop_arrow"
        android:roundIcon="@drawable/ic_drop_arrow"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:resizeableActivity="true"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTop">
            <!-- Default 3:2 horizontal desktop window size (960dp x 640dp, min 780dp x 520dp) -->
            <layout
                android:defaultWidth="960dp"
                android:defaultHeight="640dp"
                android:gravity="center"
                android:minWidth="780dp"
                android:minHeight="520dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Right-Click a video in Files -> Open with / Share -> "Compress video (~50mb)" -->
        <activity
            android:name=".VideoCompressActivity"
            android:label="Compress video (~50mb)"
            android:resizeableActivity="true"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTop"
            android:excludeFromRecents="false">
            <layout
                android:defaultWidth="480dp"
                android:defaultHeight="360dp"
                android:gravity="center"
                android:minWidth="420dp"
                android:minHeight="300dp" />
            <intent-filter android:label="Compress video (~50mb)">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter android:label="Compress video (~50mb)">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- Right-Click a video in Files -> Open with / Share -> "Convert video to GIF (<50mb)" -->
        <activity
            android:name=".VideoToGifActivity"
            android:label="Convert video to GIF (&lt;50mb)"
            android:resizeableActivity="true"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTop"
            android:excludeFromRecents="false">
            <layout
                android:defaultWidth="620dp"
                android:defaultHeight="520dp"
                android:gravity="center"
                android:minWidth="500dp"
                android:minHeight="440dp" />
            <intent-filter android:label="Convert video to GIF (&lt;50mb)">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter android:label="Convert video to GIF (&lt;50mb)">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- Right-Click an image in Files -> Open with / Share -> "Compress image" -->
        <activity
            android:name=".ImageCompressActivity"
            android:label="Compress image"
            android:resizeableActivity="true"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTop"
            android:excludeFromRecents="false">
            <layout
                android:defaultWidth="480dp"
                android:defaultHeight="360dp"
                android:gravity="center"
                android:minWidth="420dp"
                android:minHeight="300dp" />
            <intent-filter android:label="Compress image">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter android:label="Compress image">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Right-Click an image in Files -> Open with / Share -> "Upscale image (2x HD)" -->
        <activity
            android:name=".ImageUpscaleActivity"
            android:label="Upscale image (2x HD)"
            android:resizeableActivity="true"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTop"
            android:excludeFromRecents="false">
            <layout
                android:defaultWidth="480dp"
                android:defaultHeight="360dp"
                android:gravity="center"
                android:minWidth="420dp"
                android:minHeight="300dp" />
            <intent-filter android:label="Upscale image (2x HD)">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter android:label="Upscale image (2x HD)">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".TopBarDropService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <receiver
            android:name=".UpdateInstallReceiver"
            android:exported="false" />
    </application>
</manifest>
