<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Detached top accent dot + main vertical shaft + rounded downward chevron (45-deg lime-to-teal gradient, no background) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,3.75L12,4.75M12,8.25L12,16.75M7.75,12.75L12,17L16.25,12.75"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="4"
                android:startY="4"
                android:endX="20"
                android:endY="20"
                android:startColor="#FFA3E635"
                android:centerColor="#FF2DD4BF"
                android:endColor="#FF0D9488" />
        </aapt:attr>
    </path>

    <!-- Subtle rounded landing curve beneath the arrow (45-deg lime-to-teal gradient) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M6.75,20C9.25,21 14.75,21 17.25,20"
        android:strokeWidth="2.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="4"
                android:startY="4"
                android:endX="20"
                android:endY="20"
                android:startColor="#FFA3E635"
                android:centerColor="#FF2DD4BF"
                android:endColor="#FF0D9488" />
        </aapt:attr>
    </path>
</vector>
